      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}
    },
    {
      "id": 6,
      "title": "Unresolved dead letters",
      "type": "stat",
      "targets": [{"expr": "autoswe_unresolved_dead_letters"}],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16}
    },
    {
