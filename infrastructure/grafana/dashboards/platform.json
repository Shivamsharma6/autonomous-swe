      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Workflow time in state (p95)",
      "type": "timeseries",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, state) (rate(workflow_state_duration_seconds_bucket[5m])))", "legendFormat": "{{state}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "title": "Approval and UAMS waits (p95)",
      "type": "timeseries",
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, state) (rate(approval_wait_duration_seconds_bucket[5m])))", "legendFormat": "approval {{state}}"},
        {"expr": "histogram_quantile(0.95, sum by (le, state) (rate(uams_wait_duration_seconds_bucket[5m])))", "legendFormat": "uams {{state}}"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 4,
