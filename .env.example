# Copy to .env and replace every required value before starting AutoSWE.
AUTOSWE_ENV=production
AUTOSWE_ADMIN_TOKEN=
AUTOSWE_DATABASE_URL=postgresql+asyncpg://autoswe:change-me@postgres:5432/autoswe
AUTOSWE_REDIS_URL=redis://redis:6379/0

# UAMS is an already-running external service; it is not part of this Compose stack.
AUTOSWE_UAMS_URL=http://host.docker.internal:8000
AUTOSWE_UAMS_TOKEN=
AUTOSWE_UAMS_TIMEOUT_SECONDS=15

# Any OpenAI-compatible endpoint, including a local Ollama or Unsloth gateway.
AUTOSWE_MODEL_BASE_URL=http://host.docker.internal:11434/v1
AUTOSWE_MODEL_API_KEY=

AUTOSWE_CORS_ORIGINS=["http://localhost:3000"]
AUTOSWE_ARTIFACT_ROOT=/var/lib/autoswe/artifacts
AUTOSWE_MANAGED_WORKTREE_ROOT=/var/lib/autoswe/worktrees
AUTOSWE_PYTHON_RUNNER_IMAGE=ghcr.io/your-org/autoswe-python-runner@sha256:replace-with-pinned-digest
AUTOSWE_NODE_RUNNER_IMAGE=ghcr.io/your-org/autoswe-node-runner@sha256:replace-with-pinned-digest

AUTOSWE_MAX_PARALLEL_TASKS=8
AUTOSWE_MAX_PARALLEL_TASKS_PER_PROJECT=4
AUTOSWE_MAX_MODEL_CONCURRENCY=4
AUTOSWE_MAX_SANDBOX_CONCURRENCY=4
AUTOSWE_MAX_DYNAMIC_TASKS=24
AUTOSWE_MAX_PLAN_DEPTH=12
AUTOSWE_MAX_TOTAL_BUDGET_USD=25
AUTOSWE_MAX_TOTAL_EXECUTION_SECONDS=7200
