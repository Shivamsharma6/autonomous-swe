# Run ./scripts/init-admin-token.sh before Docker Compose. Generated secrets remain in .env.
AUTOSWE_ENV=production
AUTOSWE_ADMIN_TOKEN=
AUTOSWE_POSTGRES_PASSWORD=

# Host directory mirrored at the same absolute path inside workers/sandbox-manager so the
# Docker daemon can bind managed worktrees without exposing any unrelated host directory.
AUTOSWE_HOST_RUNTIME_ROOT=/var/lib/autoswe
AUTOSWE_UID=65532
AUTOSWE_GID=65532

# UAMS is an already-running EXTERNAL service. Compose never starts or stores UAMS data.
AUTOSWE_UAMS_URL=http://host.docker.internal:8000
AUTOSWE_UAMS_TOKEN=
AUTOSWE_UAMS_TIMEOUT_SECONDS=15

# OpenAI-compatible model endpoint (local or remote).
AUTOSWE_MODEL_BASE_URL=http://host.docker.internal:11434/v1
AUTOSWE_MODEL_API_KEY=
AUTOSWE_MODEL_PRIMARY=qwen3-coder
AUTOSWE_MODEL_FALLBACKS=[]
AUTOSWE_MODEL_TIMEOUT_SECONDS=120
AUTOSWE_MODEL_INPUT_COST_PER_MILLION=0
AUTOSWE_MODEL_CACHED_INPUT_COST_PER_MILLION=0
AUTOSWE_MODEL_OUTPUT_COST_PER_MILLION=0
AUTOSWE_MODEL_CAPABILITY_MODE=declared
AUTOSWE_MODEL_DECLARED_CAPABILITIES=["structured_outputs","native_tool_calls","streaming","usage_accounting"]

AUTOSWE_CORS_ORIGINS=["http://localhost:3000"]
AUTOSWE_API_PORT=8080
AUTOSWE_WEB_PORT=3000
AUTOSWE_API_RATE_LIMIT_PER_MINUTE=120
AUTOSWE_REQUEST_MAX_BYTES=1048576
AUTOSWE_SANDBOX_MANAGER_URL=http://sandbox-manager:8090

# Immutable, policy-approved execution images.
AUTOSWE_PYTHON_RUNNER_IMAGE=ghcr.io/astral-sh/uv@sha256:531f855bda2c73cd6ef67d56b733b357cea384185b3022bd09f05e002cd144ca
AUTOSWE_NODE_RUNNER_IMAGE=node@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436

AUTOSWE_MAX_PARALLEL_TASKS=8
AUTOSWE_MAX_PARALLEL_TASKS_PER_PROJECT=4
AUTOSWE_MAX_MODEL_CONCURRENCY=4
AUTOSWE_MAX_SANDBOX_CONCURRENCY=4
AUTOSWE_MAX_DYNAMIC_TASKS=24
AUTOSWE_MAX_PLAN_DEPTH=12
AUTOSWE_MAX_TOTAL_BUDGET_USD=25
AUTOSWE_MAX_TOTAL_EXECUTION_SECONDS=7200

# Optional OpenTelemetry/LangSmith values are injected at runtime, never committed.
OTEL_EXPORTER_OTLP_ENDPOINT=
AUTOSWE_GRAFANA_ADMIN_PASSWORD=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=autoswe-production
